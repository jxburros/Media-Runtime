{
  "directory": ".runtime",
  "port": 7810,
  "queue_capacity": 32,
  "cancellation_grace_ms": 10000,
  "worker_timeout_ms": 30000,
  "poll_interval_ms": 250,
  "max_output_bytes": {
    "image/png": 33554432,
    "application/zip": 268435456,
    "video/mp4": 268435456,
    "audio/wav": 67108864
  },
  "output_retention_days": null,
  "artifact_catalog": {
    "sdxl-base": "/absolute/path/to/local/sdxl-base",
    "studio-style-lora": "/absolute/path/to/local/studio-style-lora",
    "esrgan-x2": "/absolute/path/to/local/esrgan-x2"
  },
  "credentials": [
    {
      "token_env": "MEDIA_RUNTIME_TOKEN",
      "namespace": "owner",
      "operator": true,
      "allow_fallbacks": true
    },
    {
      "token_env": "MEDIA_STUDIO_TOKEN",
      "namespace": "studio",
      "operator": false,
      "allowed_namespaces": [
        "studio:*"
      ]
    }
  ],
  "worker": {
    "url": "http://127.0.0.1:7811",
    "token_env": "MEDIA_ENGINE_TOKEN",
    "backend_id": "diffusers-sdxl"
  },
  "max_input_bytes": 33554432
}
